@model IReadOnlyList<EFCore.Dashboard.Pages.Admin.DeleteReferenceLink>
@if (Model.Count > 0)
{
    <ul class="dash-delete-references">
    @foreach (var reference in Model)
    {
        var url = Url.Page("/Admin/Resource", new
        {
            resourceName = reference.ResourceSlug,
            filterField = reference.ForeignKeyProperty,
            filterValue = reference.ForeignKeyValue
        });
        <li>'@reference.PrincipalLabel' is used through <strong>@reference.ForeignKeyLabel</strong>. <a href="@url">View @reference.Count.ToString("N0") related @reference.ResourceLabel</a>.</li>
    }
    </ul>
}
