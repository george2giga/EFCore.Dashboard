<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Dashboard Blog is an independent publication about considered software and the people who make it." />
    <title>@ViewData["Title"] - Dashboard Blog</title>
    <link rel="stylesheet" href="~/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <a class="wordmark" asp-page="/Index" aria-label="Dashboard Blog home">
            <span class="wordmark-mark">DB</span>
            <span>Dashboard Blog</span>
        </a>
        <nav class="site-nav" aria-label="Main navigation">
            <a asp-page="/Index" asp-fragment="latest">Stories</a>
            <a asp-page="/Index" asp-fragment="writers">Writers</a>
            <a asp-page="/Index" asp-fragment="newsletter">Letters</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="nav-admin" href="~/admin">Dashboard</a>
                <form method="post" asp-page="/Logout"><button type="submit">Sign out</button></form>
            }
            else
            {
                <a class="nav-admin" asp-page="/Login">Editor sign in</a>
            }
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div><span class="wordmark-mark">DB</span> Independent notes on considered software.</div>
        <div>Built with Razor Pages, EF Core, and <a href="~/admin">EFCore.Dashboard</a>.</div>
    </footer>
</body>
</html>
