@page "/stories/{slug}"
@model ArticleModel
@{
    var article = Model.Article!;
    ViewData["Title"] = article.Title;
}

<article class="article-page">
    <header class="article-header">
        <p class="kicker">@article.Category.Name / @article.PublishedAt?.ToString("dd MMMM yyyy")</p>
        <h1>@article.Title</h1>
        <p class="article-deck">@article.Excerpt</p>
        <div class="byline article-byline">
            <img src="@article.Author.AvatarUrl" alt="" />
            <span>By <a asp-page="/Author" asp-route-slug="@article.Author.Slug">@article.Author.Name</a></span>
            <span>@article.ReadingMinutes min read</span>
        </div>
    </header>

    <div class="article-grid">
        <aside class="article-aside">
            <span>Filed under</span>
            @foreach (var tag in article.Tags.OrderBy(tag => tag.Name)) { <strong>@tag.Name</strong> }
        </aside>
        <div class="article-body">
            @foreach (var paragraph in article.Content.Split("\n\n", StringSplitOptions.RemoveEmptyEntries))
            {
                <p>@paragraph</p>
            }
        </div>
    </div>

    <footer class="author-note">
        <img src="@article.Author.AvatarUrl" alt="Portrait of @article.Author.Name" />
        <div><span>Written by</span><h2><a asp-page="/Author" asp-route-slug="@article.Author.Slug">@article.Author.Name</a></h2><p>@article.Author.Bio</p></div>
    </footer>
</article>

<section class="comments" id="comments">
    <div class="comments-list">
        <header><span class="kicker">Conversation</span><h2>@article.Comments.Count approved @(article.Comments.Count == 1 ? "comment" : "comments")</h2></header>
        @foreach (var comment in article.Comments.OrderBy(comment => comment.CreatedAt))
        {
            <article><div><strong>@comment.AuthorName</strong><time datetime="@comment.CreatedAt.ToString("O")">@comment.CreatedAt.ToString("dd MMM yyyy")</time></div><p>@comment.Body</p></article>
        }
        @if (article.Comments.Count == 0) { <p class="empty-state">No comments yet. Leave the first note.</p> }
    </div>
    <div class="comment-form-wrap">
        <h2>Leave a note</h2>
        @if (Request.Query["commented"] == "True" || Request.Query["commented"] == "true")
        {
            <p class="form-notice">Received. Comments appear after editorial review.</p>
        }
        else
        {
            <p>Your email is kept private. New comments are reviewed before publication.</p>
            <form method="post" asp-page-handler="Comment">
                <div asp-validation-summary="ModelOnly" class="form-errors"></div>
                <label asp-for="Comment.Name">Name</label><input asp-for="Comment.Name" /><span asp-validation-for="Comment.Name"></span>
                <label asp-for="Comment.Email">Email</label><input asp-for="Comment.Email" /><span asp-validation-for="Comment.Email"></span>
                <label asp-for="Comment.Body">Comment</label><textarea asp-for="Comment.Body" rows="5"></textarea><span asp-validation-for="Comment.Body"></span>
                <input asp-for="Comment.Website" class="form-trap" tabindex="-1" autocomplete="off" aria-hidden="true" />
                <button type="submit">Send for review</button>
            </form>
        }
    </div>
</section>

@if (Model.Related.Count > 0)
{
    <section class="related-stories"><header class="section-heading"><div><span>Continue reading</span><h2>From @article.Category.Name</h2></div></header><div class="related-grid">
    @foreach (var related in Model.Related)
    {
        <a asp-page="/Article" asp-route-slug="@related.Slug"><span><small>@related.Author.Name</small><strong>@related.Title</strong></span><span aria-hidden="true">&#8599;</span></a>
    }
    </div></section>
}
